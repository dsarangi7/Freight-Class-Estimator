---
interface Props {
  current?: "home" | "faq" | "about" | "contact" | "none";
}
const { current = "none" } = Astro.props;
---

<header class="site-header sticky top-0 z-40 border-b border-hairline bg-canvas-elevated/95 backdrop-blur supports-[backdrop-filter]:bg-canvas-elevated/90">
  <div class="site-wrap flex flex-wrap items-center justify-between gap-2 py-2.5 sm:gap-3 sm:py-3.5">
    <a
      href="/"
      class="group inline-flex min-h-11 items-center gap-2 no-underline text-ink hover:text-ink"
      aria-label="Freight Class Estimator home"
    >
      <img
        src="/icons/android-chrome-192x192.png"
        width="32"
        height="32"
        alt=""
        class="h-8 w-8 rounded-[6px]"
        decoding="async"
      />
      <span class="text-[15px] font-semibold tracking-tight">
        Freight Class Estimator
      </span>
    </a>
    <nav class="flex w-full flex-nowrap items-center gap-0.5 overflow-x-auto pb-1 text-sm sm:w-auto sm:flex-wrap sm:overflow-visible sm:pb-0 sm:gap-1" aria-label="Primary">
      <a
        href="/"
        class:list={[
          "inline-flex min-h-11 shrink-0 items-center rounded-[6px] px-3 py-2 no-underline",
          current === "home" ? "bg-hairline-soft font-medium text-ink" : "text-body hover:bg-hairline-soft hover:text-ink",
        ]}
        aria-current={current === "home" ? "page" : undefined}
      >Calculator</a>
      <a
        href="/faq/"
        class:list={[
          "inline-flex min-h-11 shrink-0 items-center rounded-[6px] border border-hairline bg-canvas-elevated px-3 py-2 font-medium no-underline",
          current === "faq" ? "border-ink bg-ink text-on-primary" : "text-ink hover:bg-hairline-soft",
        ]}
        aria-current={current === "faq" ? "page" : undefined}
      >FAQ</a>
      <a
        href="/about/"
        class:list={[
          "inline-flex min-h-11 shrink-0 items-center rounded-[6px] px-3 py-2 no-underline",
          current === "about" ? "bg-hairline-soft font-medium text-ink" : "text-body hover:bg-hairline-soft hover:text-ink",
        ]}
        aria-current={current === "about" ? "page" : undefined}
      >About</a>
      <a
        href="/contact/"
        class:list={[
          "inline-flex min-h-11 shrink-0 items-center rounded-[6px] px-3 py-2 no-underline",
          current === "contact" ? "bg-hairline-soft font-medium text-ink" : "text-body hover:bg-hairline-soft hover:text-ink",
        ]}
        aria-current={current === "contact" ? "page" : undefined}
      >Contact</a>
      <button
        type="button"
        class="theme-toggle inline-flex min-h-11 shrink-0 items-center rounded-[6px] border border-hairline bg-canvas-elevated px-3 py-2 font-medium text-ink hover:bg-hairline-soft"
        data-theme-toggle
        aria-label="Switch to night mode"
        aria-pressed="false"
      >
        <span data-theme-icon aria-hidden="true">Night</span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const themeIcon = document.querySelector("[data-theme-icon]");

  const setThemeToggleState = () => {
    const isDark = document.documentElement.classList.contains("dark");
    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to night mode");
    if (themeIcon) themeIcon.textContent = isDark ? "Day" : "Night";
  };

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("freightclassestimator-theme", isDark ? "dark" : "light");
    setThemeToggleState();
  });

  setThemeToggleState();
</script>
