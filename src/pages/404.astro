---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Page not found | Freight Class Estimator"
  description="The page you requested was not found on Freight Class Estimator."
  canonicalPath="/404"
  noindex={true}
>
  <SiteHeader slot="header" />
  <div class="site-wrap py-20 text-center">
    <p class="font-mono text-xs uppercase tracking-wide text-mute">404</p>
    <h1 class="mt-2 text-3xl tracking-tight">Page not found</h1>
    <p class="mt-3 text-body">That URL is not on Freight Class Estimator.</p>
    <p class="mt-6">
      <a href="/" class="btn-primary no-underline">Freight class calculator</a>
    </p>
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>
